/*
 * The example programs for the API reference, each with a short description.
 */

/**
 * @example write_heights.c
 * @details Write SDF files of both revisions with the heights API.
 */

/**
 * @example read_heights.c
 * @details Read an SDF file with the heights API.
 */

/**
 * @example write_coded.c
 * @details Write an SDF file with the coded values API.
 */

/**
 * @example read_coded.c
 * @details Read an SDF file with the coded values API.
 */

/**
 * @example read_stream.c
 * @details Read an SDF file from a stream row by row.
 */

/**
 * @example custom_allocator.c
 * @details Write an SDF file to memory with a custom allocator.
 */

/**
 * @example custom_tz.c
 * @details Convert the dates of an ISO-1.0 file with a fixed-offset time zone.
 */

/**
 * @example opencv.cpp
 * @details Smooth an SDF file with OpenCV.
 */

/**
 * @example eigen.cpp
 * @details Remove the best-fit plane of an SDF file with Eigen.
 */

/**
 * @example vtk.cpp
 * @details Display an SDF file with VTK.
 */
