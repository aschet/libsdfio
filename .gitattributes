# Normalize line endings in the repository, check out native.
* text=auto

# Sources and build files are text on every platform.
*.c text
*.h text
*.in text
*.cmake text
*.txt text
*.json text
*.py text
*.yml text
*.md text
*.toml text

# Test data is compared byte by byte: the line ends of an ASCII file matter.
*.sdf binary
tests/data/expected.txt -text
